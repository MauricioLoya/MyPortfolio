---
import presentation from '@/data/presentation'
---

<section class="py-16 md:py-24 lg:py-32">
  <div class="grid lg:grid-cols-[1fr_360px] gap-12 lg:gap-16 items-start lg:items-center">
    <div class="space-y-8">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald/10 border border-emerald/20 text-emerald text-sm">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full rounded-full bg-emerald opacity-75 animate-ping"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald"></span>
        </span>
        Disponible para nuevos proyectos
      </div>

      <div class="space-y-3">
        <h1 class="font-display font-semibold tracking-tight" style="font-size: var(--text-display); line-height: 1.1;">
          {presentation.name}
        </h1>
        <p class="text-xl md:text-2xl text-emerald font-medium">
          {presentation.headline}
        </p>
        <div class="flex items-center gap-2 text-cream/50 text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          {presentation.location}
        </div>
      </div>

      <p class="text-base md:text-lg text-cream/70 max-w-xl leading-relaxed">
        {presentation.profile}
      </p>

      <div class="flex flex-wrap gap-3">
        <a 
          href={`mailto:${presentation.email}`}
          class="btn-primary"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Enviar Email
        </a>
        <a 
          href={presentation.socials.find(s => s.network === 'LinkedIn')?.link}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
      </div>
    </div>

    <div class="hidden lg:block card">
      <div class="flex items-center gap-4 pb-5 border-b border-white/10">
        <img 
          src="https://avatars.githubusercontent.com/u/39864828?v=4" 
          alt={presentation.name}
          class="w-16 h-16 rounded-full object-cover border-2 border-emerald/30"
        />
        <div>
          <p class="font-semibold text-cream">{presentation.name}</p>
          <p class="text-sm text-cream/60">{presentation.headline}</p>
        </div>
      </div>
      
      <div class="space-y-3 pt-5">
        <div class="pt-5">
        <div class="flex items-center gap-3 text-sm text-cream/70">
          <svg class="w-4 h-4 text-emerald" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="truncate">{presentation.email}</span>
        </div>
      </div>

      <div class="flex gap-2 pt-5 border-t border-white/10">
        {presentation.socials.map(social => (
          <a 
            href={social.link}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-md bg-white/5 text-xs text-cream/60 hover:bg-emerald/10 hover:text-emerald transition-colors"
          >
            {social.network}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
