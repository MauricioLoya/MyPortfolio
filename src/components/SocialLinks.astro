---
import presentation from '@/data/presentation'
---

<div class="flex items-center gap-4">
  {presentation.socials.map((social) => (
    <a
      href={social.link}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm text-cream/50 hover:text-emerald transition-colors"
    >
      {social.network}
    </a>
  ))}
</div>
