---
export type Project = {
  title: string
  link?: string
  techs: string[]
  isComingSoon?: boolean
  slug: string
  image: string
}

type Props = Project

const { title, isComingSoon, slug, image, techs } = Astro.props

const formatTechs = (values: string[]) =>
  values.toString().replaceAll(',', ' • ')
---

<>
  {
    isComingSoon && (
      <div class="card">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="font-semibold text-cream">{title}</h3>
            <p class="text-sm text-cream/50 mt-1">{formatTechs(techs)}</p>
          </div>
          <span class="px-3 py-1 rounded-full bg-emerald/10 text-emerald text-sm">Próximamente</span>
        </div>
      </div>
    )
  }

  {
    !isComingSoon && (
      <a
        class="group block rounded-xl overflow-hidden border border-white/5 hover:border-emerald/30 transition-colors duration-300"
        href={`/projects/${slug}`}
        rel="noreferrer"
      >
        <div class="aspect-video bg-slate-900 overflow-hidden">
          <img
            height="144"
            width="208"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            src={image}
            alt={title}
            onerror="this.src='https://via.placeholder.com/400x225/0a0a0b/B87333?text=Proyecto'"
          />
        </div>
        
        <div class="p-4">
          <h3 class="font-medium text-cream group-hover:text-emerald transition-colors">
            {title}
          </h3>
          <p class="text-xs text-cream/50 mt-1">{formatTechs(techs)}</p>
        </div>
      </a>
    )
  }
</>
