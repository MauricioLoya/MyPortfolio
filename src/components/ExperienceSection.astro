---
import presentation from '@/data/presentation'

const formatDate = (dateStr: string) => {
  if (dateStr === 'present') return 'Actualidad'
  const [year, month] = dateStr.split('-')
  const months: Record<string, string> = {
    '01': 'Ene', '02': 'Feb', '03': 'Mar', '04': 'Abr',
    '05': 'May', '06': 'Jun', '07': 'Jul', '08': 'Ago',
    '09': 'Sep', '10': 'Oct', '11': 'Nov', '12': 'Dic'
  }
  return `${months[month] || month} ${year}`
}
---

<section class="py-16 md:py-24">
  <h2 class="text-2xl md:text-3xl font-display font-semibold mb-12">Experiencia Profesional</h2>

  <div class="space-y-8">
    {presentation.experience.map((exp, index) => (
      <article 
        class="relative pl-8 md:pl-10 pb-10 border-l border-emerald/30 last:pb-0 group"
      >
        <div class="absolute left-0 top-0 w-3 h-3 -translate-x-[7px] rounded-full bg-dark border-2 border-emerald group-hover:bg-emerald transition-colors duration-300"></div>
        
        <div class="bg-slate-900/50 rounded-2xl p-6 md:p-8 border border-white/5 hover:border-emerald/20 transition-colors duration-300">
          <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
            <div>
              <h3 class="text-lg md:text-xl font-semibold text-cream group-hover:text-emerald transition-colors">
                {exp.position}
              </h3>
              <p class="text-emerald font-medium">{exp.company}</p>
            </div>
            <div class="text-right">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald/10 text-emerald text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                {formatDate(exp.startDate)} — {formatDate(exp.endDate)}
              </div>
              <p class="text-sm text-cream/50 mt-1">{exp.location}</p>
            </div>
          </div>

          <p class="text-cream/70 mb-6 leading-relaxed">
            {exp.summary}
          </p>

          <div class="space-y-3">
            {exp.highlights.map((highlight) => (
              <div class="flex gap-3 items-start">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald mt-2 flex-shrink-0"></span>
                <p class="text-sm text-cream/60 leading-relaxed">{highlight}</p>
              </div>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
