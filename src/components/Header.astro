---
import removeTrailingSlash from '@/utils/removeTrailingSlash'
import presentation from '@/data/presentation'

const pathname = removeTrailingSlash(Astro.url.pathname)

const navItems = [
  { href: '/projects', label: 'Proyectos' },
  { href: '/posts', label: 'Blog' },
]
---

<header class="sticky top-0 z-50 backdrop-blur-xl bg-dark/80 border-b border-white/5">
  <div class="max-w-6xl mx-auto px-5 md:px-10">
    <nav class="flex items-center justify-between h-14 md:h-16">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-8 h-8 rounded-lg bg-emerald flex items-center justify-center text-dark font-bold text-sm">
          {presentation.name.charAt(0)}
        </div>
        <span class="font-medium text-cream text-sm hidden sm:block group-hover:text-emerald transition-colors">
          {presentation.name}
        </span>
      </a>

      <div class="flex items-center gap-6">
        <ul role="list" class="hidden md:flex items-center gap-5">
          {navItems.map(item => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'text-sm transition-colors relative',
                  pathname === item.href 
                    ? 'text-emerald font-medium' 
                    : 'text-cream/50 hover:text-cream'
                ]}
              >
                {item.label}
                {pathname === item.href && (
                  <span class="absolute -bottom-0.5 left-0 w-full h-px bg-emerald"></span>
                )}
              </a>
            </li>
          ))}
        </ul>

        <a
          href={`mailto:${presentation.email}`}
          class="text-sm text-emerald hover:text-emeraldLight transition-colors hidden md:block"
        >
          Contacto
        </a>

        <button 
          id="menu-toggle"
          class="md:hidden p-1.5 text-cream/50 hover:text-cream transition-colors"
          aria-label="Abrir menú"
          aria-expanded="false"
        >
          <svg id="menu-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </nav>

    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <ul role="list" class="space-y-2 pt-4 border-t border-white/5">
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class:list={[
                'block text-sm transition-colors py-2',
                pathname === item.href 
                  ? 'text-emerald font-medium' 
                  : 'text-cream/50 hover:text-cream'
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href={`mailto:${presentation.email}`}
            class="block text-sm text-emerald hover:text-emeraldLight transition-colors py-2"
          >
            Contacto
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle')
  const menu = document.getElementById('mobile-menu')
  const menuIcon = document.getElementById('menu-icon')
  const closeIcon = document.getElementById('close-icon')

  if (toggle && menu && menuIcon && closeIcon) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('hidden')
      menuIcon.classList.toggle('hidden')
      closeIcon.classList.toggle('hidden')
      toggle.setAttribute('aria-expanded', String(!isOpen))
      toggle.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú')
    })
  }
</script>
