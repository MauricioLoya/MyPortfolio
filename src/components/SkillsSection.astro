---
import presentation from '@/data/presentation'
---

<section class="py-16 md:py-24">
  <h2 class="text-2xl md:text-3xl font-display font-semibold mb-12">Habilidades Técnicas</h2>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
    {presentation.skills.map((skill) => (
      <div 
        class="group p-5 rounded-xl bg-slate-900/50 border border-white/5 hover:border-emerald/30 transition-colors duration-300"
      >
        <div class="flex items-center gap-3 mb-4">
          <div class="w-9 h-9 rounded-lg bg-emerald/10 border border-emerald/20 flex items-center justify-center group-hover:bg-emerald/20 transition-colors">
            <svg class="w-4 h-4 text-emerald" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h3 class="font-semibold text-cream text-sm group-hover:text-emerald transition-colors">
            {skill.label}
          </h3>
        </div>
        
        <div class="flex flex-wrap gap-1.5">
          {skill.details.split(', ').map((tech: string) => (
            <span class="px-2.5 py-1 rounded-md bg-white/5 text-xs text-cream/60 hover:bg-emerald/10 hover:text-emerald transition-colors cursor-default">
              {tech}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
