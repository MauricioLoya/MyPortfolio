---
import formatDate from "@/utils/formatDate";

type Props = {
  title: string;
  publishedAt: Date;
  description: string;
  slug: string;
};

const { title, publishedAt, description, slug } = Astro.props;
---

<a
  class="group relative overflow-hidden rounded-2xl bg-slate-800/30 border border-white/5 hover:border-emerald/30 transition-all duration-300 hover:-translate-y-1 p-6"
  href={`/posts/${slug}`}
>
  <div class="flex items-start justify-between gap-4 mb-4">
    <h3 class="font-semibold text-cream group-hover:text-emerald transition-colors leading-tight">
      {title}
    </h3>
    <div class="flex items-center gap-2 text-sm text-cream/50 whitespace-nowrap">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      {formatDate(publishedAt)}
    </div>
  </div>

  <p class="text-sm text-cream/60 line-clamp-2 leading-relaxed">
    {description}
  </p>

  <div class="mt-4 flex items-center gap-2 text-emerald text-sm font-medium">
    Leer más
    <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </div>
</a>
