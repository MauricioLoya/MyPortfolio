---
import presentation from '@/data/presentation'
---

<section class="py-16 md:py-24">
  <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
    <div>
      <h2 class="text-2xl md:text-3xl font-display font-semibold mb-10">Educación</h2>

      <div class="space-y-5">
        {presentation.education.map((edu) => (
          <article 
            class="p-5 rounded-xl bg-slate-900/50 border border-white/5 hover:border-emerald/20 transition-colors duration-300"
          >
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h3 class="font-semibold text-cream">{edu.area}</h3>
                <p class="text-emerald text-sm mt-0.5">{edu.institution}</p>
              </div>
              <div class="text-right">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 text-sm text-cream/60">
                  {edu.startDate.split('-')[0]} — {edu.endDate.split('-')[0]}
                </div>
              </div>
            </div>
            <p class="text-sm text-cream/50 mt-3 flex items-center gap-2">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {edu.location}
            </p>
          </article>
        ))}
      </div>
    </div>

    <div>
      <h2 class="text-2xl md:text-3xl font-display font-semibold mb-10">Logros</h2>

      <div class="space-y-4">
        {presentation.achievements.map((achievement) => (
          <div 
            class="flex gap-4 p-5 rounded-xl bg-emerald/5 border border-emerald/20 hover:border-emerald/40 transition-colors duration-300"
          >
            <div class="w-10 h-10 rounded-lg bg-emerald/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-emerald" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
            </div>
            <p class="text-cream/80 text-sm leading-relaxed">{achievement.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
